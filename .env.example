# ---------------------------------------------------------------
# Variables de entorno del backend (LibrosCuba)
# Copia este archivo a `.env` para desarrollo local
# En Render se configuran en Dashboard → Environment.
# ---------------------------------------------------------------

# MongoDB ---------------------------------------------------------
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB=libroscuba

# JWT -------------------------------------------------------------
# En producción usa una cadena aleatoria larga (>=32 caracteres).
# Render puede generarla por ti con `generateValue: true` en render.yaml.
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Cloudinary (opcional) -------------------------------------------
# Si las dejas vacías, el endpoint de upload queda deshabilitado y
# los usuarios deben pegar una URL de imagen directa.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email OTP (registro) --------------------------------------------
OTP_EXPIRE_MINUTES=5

# Producción en Render (recomendado): Resend por HTTPS — plan free de Render BLOQUEA Gmail SMTP.
# 1. https://resend.com → API Keys → crear clave
# 2. Pruebas: RESEND_FROM=onboarding@resend.dev (solo envía al email de tu cuenta Resend)
# 3. Producción: verifica tu dominio en Resend y usa ej. LibrosCuba <noreply@tudominio.com>
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=LibrosCuba <onboarding@resend.dev>

# Desarrollo local (opcional): Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucuenta@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
SMTP_FROM=tucuenta@gmail.com

# CORS ------------------------------------------------------------
# Lista de orígenes permitidos separados por coma (sin barra final).
# Local:        http://localhost:5173,http://127.0.0.1:5173
# Producción:   https://tu-frontend.netlify.app,https://www.tu-dominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
