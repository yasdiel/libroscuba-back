# ---------------------------------------------------------------
# Variables de entorno del backend (LibrosCuba)
# Copia este archivo a `.env` para desarrollo local
# En Render se configuran en Dashboard → Environment.
# ---------------------------------------------------------------

# MongoDB ---------------------------------------------------------
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB=libroscuba

# JWT -------------------------------------------------------------
# En producción usa una cadena aleatoria larga (>=32 caracteres).
# Render puede generarla por ti con `generateValue: true` en render.yaml.
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Cloudinary (opcional) -------------------------------------------
# Si las dejas vacías, el endpoint de upload queda deshabilitado y
# los usuarios deben pegar una URL de imagen directa.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS ------------------------------------------------------------
# Lista de orígenes permitidos separados por coma (sin barra final).
# Local:        http://localhost:5173,http://127.0.0.1:5173
# Producción:   https://tu-frontend.netlify.app,https://www.tu-dominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# elTOQUE — tasas TRMI (https://tasas.eltoque.com/v1/trmi)
EL_TOQUE_API_TOKEN=
